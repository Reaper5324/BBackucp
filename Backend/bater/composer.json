{
    "name": "bater/marketplace",
    "description": "Bater C2C Marketplace for South African informal township trade",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "stripe/stripe-php": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Bater\\": "src/"
        },
        "classmap": [
            "core/",
            "database/",
            "middleware/",
            "models/",
            "services/",
            "controllers/"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
